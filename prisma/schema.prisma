generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["supplyease"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model api_idempotency_keys {
  staff_user_id   String      @db.Uuid
  operation_code  String
  request_key     String
  request_sha256  Bytes
  response_status Int?        @db.SmallInt
  response_body   Json?
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  expires_at      DateTime    @db.Timestamptz(6)
  staff_users     staff_users @relation(fields: [staff_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([staff_user_id, operation_code, request_key])
  @@index([expires_at], map: "api_idempotency_keys_expiry_idx")
  @@schema("supplyease")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_events {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_staff_id   String?      @db.Uuid
  actor_device_id  String?      @db.Uuid
  department_code  String?
  action_code      String
  target_type      String
  target_reference String
  request_id       String?      @db.Uuid
  details          Json         @default("{}")
  recorded_at      DateTime     @default(now()) @db.Timestamptz(6)
  devices          devices?     @relation(fields: [actor_device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_users      staff_users? @relation(fields: [actor_staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments      departments? @relation(fields: [department_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@index([department_code, recorded_at(sort: Desc)], map: "audit_events_dept_idx")
  @@index([target_type, target_reference, recorded_at(sort: Desc)], map: "audit_events_target_idx")
  @@index([recorded_at(sort: Desc)], map: "audit_events_time_idx")
  @@schema("supplyease")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model capture_runs {
  id                                              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  device_id                                       String         @unique(map: "capture_runs_active_device_uq", where: raw("(closed_at IS NULL)")) @db.Uuid
  material_lot_id                                 String?        @db.Uuid
  garment_id                                      String?        @db.Uuid
  package_id                                      String?        @db.Uuid
  opened_by                                       String         @db.Uuid
  opened_at                                       DateTime       @default(now()) @db.Timestamptz(6)
  closed_by                                       String?        @db.Uuid
  closed_at                                       DateTime?      @db.Timestamptz(6)
  close_reason                                    String?
  staff_users_capture_runs_closed_byTostaff_users staff_users?   @relation("capture_runs_closed_byTostaff_users", fields: [closed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  devices                                         devices        @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  garments                                        garments?      @relation(fields: [garment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  material_lots                                   material_lots? @relation(fields: [material_lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_users_capture_runs_opened_byTostaff_users staff_users    @relation("capture_runs_opened_byTostaff_users", fields: [opened_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packages                                        packages?      @relation(fields: [package_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  capture_steps                                   capture_steps[]

  @@unique([id, device_id])
  @@schema("supplyease")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model capture_steps {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  context_token          String                 @unique
  capture_run_id         String                 @db.Uuid
  device_id              String                 @unique(map: "capture_steps_active_device_uq", where: raw("(closed_at IS NULL)")) @db.Uuid
  task_id                String                 @unique(map: "capture_steps_completed_task_uq", where: raw("(status = 'completed'::capture_status)")) @db.Uuid
  operator_id            String                 @db.Uuid
  checkpoint_code        String
  mapping_version        Int
  sensor_code            String
  status                 capture_status         @default(awaiting_ack)
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  expires_at             DateTime               @db.Timestamptz(6)
  acknowledged_at        DateTime?              @db.Timestamptz(6)
  cleared_at             DateTime?              @db.Timestamptz(6)
  armed_at               DateTime?              @db.Timestamptz(6)
  closed_at              DateTime?              @db.Timestamptz(6)
  capture_runs           capture_runs           @relation(fields: [capture_run_id, device_id], references: [id, device_id], onDelete: NoAction, onUpdate: NoAction)
  device_sensor_mappings device_sensor_mappings @relation(fields: [device_id, mapping_version, sensor_code, checkpoint_code], references: [device_id, mapping_version, sensor_code, checkpoint_code], onDelete: NoAction, onUpdate: NoAction)
  staff_users            staff_users            @relation(fields: [operator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  work_tasks             work_tasks             @relation(fields: [task_id, checkpoint_code], references: [id, checkpoint_code], onDelete: NoAction, onUpdate: NoAction)
  sensor_observations    sensor_observations[]

  @@unique([id, device_id, context_token])
  @@schema("supplyease")
}

model carriers {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
