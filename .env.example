# WearTrail Backend Environment Configuration
# Copy this file to .env and populate with your PostgreSQL connection strings.
# DO NOT commit .env to version control or expose credentials in client-side code.

# Backend runtime: restricted WearTrail API database role (weartrail_api).
# For IPv4 environments (e.g. local Express server), use Supabase Session Pooler on port 5432.
# Format: postgresql://[user].[project-ref]:[password]@[pooler-host]:5432/postgres?schema=supplyease&sslmode=require
DATABASE_URL=""

# Lead-only CLI introspection/baseline/migration access (postgres / database owner).
# Used for `prisma db pull` and `prisma migrate` commands. Not required by teammates just to generate the client.
# Format: postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres?schema=supplyease&sslmode=require
MIGRATION_DATABASE_URL=""

